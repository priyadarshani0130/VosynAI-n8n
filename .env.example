# Google Sheets Auth
# Provide the absolute path to your Google Service Account JSON key
GOOGLE_SERVICE_KEY_PATH=/path/to/your/service-account.json

# OpenAI API (For QA AI Analysis generation)
OPENAI_API_KEY=sk-your-openai-api-key

# Email Sending Auth (For Gmail, use an App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_digit_app_password
